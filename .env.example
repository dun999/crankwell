# ── AI mechanic (any OpenAI-compatible chat completions API) ─────────
# Default: DeepSeek V4 on Boundless inference (https://inference.boundless.network)
AGENT_API_KEY=
# optional overrides
# AGENT_MODEL=dsv4
# AGENT_BASE_URL=https://api.inference.boundless.network/v1
# AGENT_MODEL_LABEL=DeepSeek V4

# Backup model, used while the primary is down, out of budget or rate limited (any OpenAI-compatible API)
# AGENT_FALLBACK_API_KEY=            # openrouter.ai → Keys
# AGENT_FALLBACK_MODEL=deepseek/deepseek-chat
# AGENT_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# AGENT_FALLBACK_LABEL=DeepSeek (OpenRouter)
# Daily token budget across providers (default 3,000,000; 0 turns it off)
# AGENT_DAILY_TOKEN_BUDGET=3000000

# ── PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox) ──
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# same client id, exposed to the browser for the PayPal JS SDK buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# from `pnpm webhook:register` (needs a public URL, see README)
PAYPAL_WEBHOOK_ID=
# sandbox *personal* (buyer) account email that receives technician invoices
INVOICE_RECIPIENT_EMAIL=

# Public base URL (tunnel) for PayPal return/cancel URLs and webhook registration
# PUBLIC_URL=https://your-tunnel.trycloudflare.com
